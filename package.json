{
  "name": "dockhand",
  "version": "0.1.0",
  "private": true,
  "description": "Docker image update bot: registry polling, GitHub PRs, Claude-analyzed changelogs, and a web UI.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types 'test/**/*.test.ts'",
    "migrate-labels": "tsx src/bin/migrate-labels.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.71.0",
    "@hono/node-server": "^1.19.0",
    "better-sqlite3": "^12.4.1",
    "croner": "^9.1.0",
    "execa": "^9.6.0",
    "hono": "^4.9.0",
    "octokit": "^5.0.3",
    "yaml": "^2.8.1",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^22.15.3",
    "tsx": "^4.20.0",
    "typescript": "^5.9.2"
  }
}
